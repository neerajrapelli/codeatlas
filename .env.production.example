# CodeAtlas production environment template
# Copy to .env and set strong secrets before deploy.

# --- Postgres ---
POSTGRES_USER=codeatlas
POSTGRES_PASSWORD=CHANGE_ME_STRONG
POSTGRES_DB=codeatlas
POSTGRES_PORT=5432

# --- API ---
API_PORT=8080
DATABASE_URL=postgresql://codeatlas:CHANGE_ME_STRONG@postgres:5432/codeatlas
WORKSPACE_ROOT=/app/workspace
CORS_ALLOWED_ORIGINS=https://your-app.example.com

# Security (required for production)
AUTH_DISABLED=false
JWT_SECRET=CHANGE_ME_RANDOM_64_CHARS
AUTH_BOOTSTRAP_SECRET=CHANGE_ME_OR_LEAVE_EMPTY_TO_DISABLE_MINT

# Optional: shared rate limits across API replicas
REDIS_URL=redis://redis:6379/0

# Ingestion / AI
INGEST_WORKER_CONCURRENCY=4
INGEST_RATE_PER_MINUTE=6
CHAT_RATE_PER_MINUTE=30
OPENAI_API_KEY=
GITHUB_TOKEN=

# --- OpenTelemetry ---
OTEL_SERVICE_NAME=codeatlas-api
OTEL_EXPORTER_OTLP_ENDPOINT=https://otel-collector.example.com/v1/traces
OTEL_EXPORTER_OTLP_INSECURE=false
OTEL_SDK_DISABLED=false

# --- Web ---
WEB_PORT=80
VITE_API_URL=/api
