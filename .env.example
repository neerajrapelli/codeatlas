# Copy to `.env` at the repo root for local Docker Compose and shared defaults.
# Never commit real secrets.

# --- Docker Compose: PostgreSQL + pgvector ---
POSTGRES_USER=codeatlas
POSTGRES_PASSWORD=codeatlas
POSTGRES_DB=codeatlas
POSTGRES_PORT=5432

# --- App connectivity (host machine -> Docker Postgres) ---
DATABASE_URL=postgresql://codeatlas:codeatlas@localhost:5432/codeatlas

# --- Go API (optional; can also live in apps/api/.env) ---
HTTP_ADDR=:8080
CORS_ALLOWED_ORIGINS=http://localhost:5173

# --- Redis (ingestion SSE pub/sub + distributed rate limits) ---
REDIS_URL=redis://localhost:6379/0
REDIS_PORT=6379

# --- Docker Compose published ports ---
API_PORT=8080
WEB_PORT=80

# --- Web (Vite dev or Docker nginx proxy prefix) ---
VITE_API_URL=http://localhost:8080

# --- API auth / secrets (override in production) ---
JWT_SECRET=change-me-in-production
AUTH_BOOTSTRAP_SECRET=dev-bootstrap-change-me
AUTH_DISABLED=true
OPENAI_API_KEY=
GITHUB_TOKEN=
INGEST_WORKER_CONCURRENCY=2

# --- OpenTelemetry (API). Leave OTLP endpoint empty to log spans to stdout. ---
OTEL_SERVICE_NAME=codeatlas-api
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_EXPORTER_OTLP_INSECURE=false
OTEL_SDK_DISABLED=false
