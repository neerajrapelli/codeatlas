# Copy to `.env` at the repo root for local Docker Compose and shared defaults.
# Never commit real secrets.

# --- Docker Compose: PostgreSQL + pgvector ---
POSTGRES_USER=codeatlas
POSTGRES_PASSWORD=codeatlas
POSTGRES_DB=codeatlas
POSTGRES_PORT=5432

# --- App connectivity (host machine -> Docker Postgres) ---
DATABASE_URL=postgresql://codeatlas:codeatlas@localhost:5432/codeatlas

# --- Go API (optional; can also live in apps/api/.env) ---
HTTP_ADDR=:8080
CORS_ALLOWED_ORIGINS=http://localhost:5173

# --- Web (optional; can also live in apps/web/.env.local) ---
VITE_API_URL=http://localhost:8080
