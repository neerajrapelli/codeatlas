# Copy to `.env` in this folder (apps/web). Vite reads env files from apps/web/

# Optional: full API URL. Leave unset in local dev to use the built-in Vite proxy (`/api` → http://localhost:8080),
# which avoids CORS and fixes "Network request failed" when the UI is opened via 127.0.0.1 vs localhost.
# VITE_API_URL=http://localhost:8080

# If your Go API runs on another host/port, point the dev proxy here:
# VITE_API_PROXY_TARGET=http://localhost:8080
