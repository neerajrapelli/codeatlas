# HTTP server bind address (Go api)
HTTP_ADDR=:8080

# PostgreSQL connection string used by ingestion + API data access.
DATABASE_URL=postgresql://codeatlas:codeatlas@localhost:5432/codeatlas

# Comma-separated browser origins allowed to call the API (CORS)
CORS_ALLOWED_ORIGINS=http://localhost:5173

# SQL migrations folder, relative to apps/api/
MIGRATIONS_DIR=./migrations
WORKSPACE_ROOT=./workspace
ZIP_MAX_BYTES=104857600
ZIP_MAX_FILES=5000

# OpenAI settings (required for /ai/chat and embedding generation during indexing)
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
AI_CONTEXT_TOKEN_BUDGET=7000

# GitHub PAT or app installation token for socio-technical history sync (Phase 1)
GITHUB_TOKEN=

# Multi-provider VCS (OAuth + encrypted user tokens)
# Generate: openssl rand -base64 32
TOKEN_ENCRYPTION_KEY=
PUBLIC_API_BASE_URL=http://localhost:8080
FRONTEND_URL=http://localhost:5173
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=
GITLAB_OAUTH_CLIENT_ID=
GITLAB_OAUTH_CLIENT_SECRET=
BITBUCKET_OAUTH_CLIENT_ID=
BITBUCKET_OAUTH_CLIENT_SECRET=
MAX_INDEX_FILE_BYTES=5242880
MAX_INDEX_FILES=5000
MAX_REPO_BYTES=524288000
# Cap OpenAI/local embedding calls per repo (0 = unlimited). Use 500–2000 for faster local dev ingest.
EMBEDDING_MAX_PER_REPO=0

# Auth (set AUTH_DISABLED=true for local dev without JWT)
JWT_SECRET=change-me-in-production
AUTH_BOOTSTRAP_SECRET=dev-bootstrap-change-me
AUTH_DISABLED=true
INGEST_RATE_PER_MINUTE=6
CHAT_RATE_PER_MINUTE=30
INGEST_WORKER_CONCURRENCY=2

# Optional: Redis for distributed rate limits + ingestion SSE pub/sub (multi-replica API)
REDIS_URL=redis://localhost:6379/0

# Indexer / graph tuning
INDEXER_PARSE_WORKERS=8
GRAPH_MAX_FILE_LIMIT=500
GRAPH_MAX_DEPTH=6

# OpenTelemetry (stdout traces when OTLP endpoint is unset)
OTEL_SERVICE_NAME=codeatlas-api
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_EXPORTER_OTLP_INSECURE=false
OTEL_SDK_DISABLED=false
